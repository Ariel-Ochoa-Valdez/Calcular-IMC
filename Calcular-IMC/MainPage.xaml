<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calcular_IMC.MainPage">

    <VerticalStackLayout
        Padding="30"
        Spacing="20">

        <Label
            Text="Calcular IMC"
            FontSize="30"
            HorizontalOptions="Center" />

        <Entry
            x:Name="Altura"
            Placeholder="Altura"
            Keyboard="Numeric" />

        <Entry
            x:Name="Peso"
            Placeholder="Peso"
            Keyboard="Numeric" />

        <Entry
            x:Name="IMC"
            Placeholder="IMC"
            IsEnabled="False" />

        <Button
            Text="CALCULAR"
            Clicked="Button_Clicked" />

    </VerticalStackLayout>

</ContentPage>